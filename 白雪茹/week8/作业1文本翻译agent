# ==========================================
# 1. 核心逻辑类：ExtractionAgent (复用你提供的代码)
# ==========================================
class ExtractionAgent:
    def __init__(self, model_name: str):
        self.model_name = model_name

    def call(self, user_prompt, response_model):
        messages = [
            {
                "role": "user",
                "content": user_prompt
            }
        ]
        
        # 动态生成 tools 的 JSON Schema
        schema = response_model.model_json_schema()
        tools = [
            {
                "type": "function",
                "function": {
                    "name": schema.get('title', 'ExtractionTask'), 
                    "description": schema.get('description', 'Extract information from text'),
                    "parameters": {
                        "type": "object",
                        "properties": schema['properties'],
                        "required": schema.get('required', []),
                    },
                }
            }
        ]

        try:
            response = client.chat.completions.create(
                model=self.model_name,
                messages=messages,
                tools=tools,
                tool_choice="auto", # 强制模型调用工具以获取结构化数据
            )
            
            # 解析返回的参数
            tool_call = response.choices[0].message.tool_calls[0]
            arguments = tool_call.function.arguments
            
            # 验证并返回 Pydantic 对象
            return response_model.model_validate_json(arguments)
        except Exception as e:
            print(f'ERROR: {e}')
            print(f'Response content: {response.choices[0].message}')
            return None

# ==========================================
# 2. 定义翻译任务的数据模型
# ==========================================
class TranslationRequest(BaseModel):
    """从用户指令中提取翻译所需的关键信息"""
    source_lang: str = Field(description="原始语种（例如：英文、中文、法文）。如果用户未指定，请根据待翻译文本自动识别。")
    target_lang: str = Field(description="目标语种（例如：中文、英文、日文）。")
    text_to_translate: str = Field(description="需要进行翻译的具体文本内容。")

# ==========================================
# 3. 测试与运行
# ==========================================

def run_translation_agent(user_input):
    print(f"👤 用户输入: {user_input}")
    
    # 实例化 Agent 并调用
    agent = ExtractionAgent(model_name="qwen-plus")
    result = agent.call(user_input, TranslationRequest)
    
    if result:
        print("✅ 提取成功:")
        print(f"   - 原始语种: {result.source_lang}")
        print(f"   - 目标语种: {result.target_lang}")
        print(f"   - 待翻译文本: {result.text_to_translate}")
        
        # 模拟后续真正的翻译步骤 (这里仅打印，实际可调用翻译API)
        print(f"   - [系统动作]: 正在调用翻译引擎，将 '{result.text_to_translate}' 从 {result.source_lang} 翻译为 {result.target_lang} ...")
    else:
        print("❌ 提取失败，无法执行翻译。")
    print("-" * 50)

